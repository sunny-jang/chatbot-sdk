{
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 0 */3 * *"
    },
    {
      "path": "/api/cron/operations",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/db-sync",
      "schedule": "0 18 * * *"
    }
  ],
  "functions": {
    "app/api/bots/[id]/docs/upload/route.ts": {
      "maxDuration": 120
    }
  }
}
